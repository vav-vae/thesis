# Firebase Authentication project whose browser ID tokens the API accepts.
FIREBASE_PROJECT_ID=libot-790e6

# Comma-separated browser origins allowed to call the API directly.
# The production frontend uses the same-origin /api/backend rewrite.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-instance protection for expensive OpenCV work.
PANORAMA_MAX_CONCURRENT_JOBS=1
PANORAMA_MAX_UPLOAD_SECONDS=120
PANORAMA_MAX_REQUEST_BYTES=132120576
PANORAMA_MAX_IMAGE_PIXELS=12500000
PANORAMA_MAX_TOTAL_IMAGE_PIXELS=100000000
PANORAMA_AUTH_IP_LIMIT=60
PANORAMA_AUTH_IP_WINDOW_SECONDS=60
# Reject Firebase sessions authenticated more than eight hours ago. Keep this
# aligned with the browser session limit in AccountStatusGuard.
PANORAMA_MAX_SESSION_AGE_SECONDS=28800
PANORAMA_VALIDATE_USER_LIMIT=60
PANORAMA_VALIDATE_IP_LIMIT=120
PANORAMA_VALIDATE_WINDOW_SECONDS=300
PANORAMA_RECONSTRUCT_USER_LIMIT=4
PANORAMA_RECONSTRUCT_IP_LIMIT=10
PANORAMA_RECONSTRUCT_WINDOW_SECONDS=600

# Leave false unless every request reaches the API through a trusted reverse proxy
# that replaces X-Forwarded-For. Vercel enables this default automatically.
TRUST_PROXY_HEADERS=false

# Optional trusted Firebase custom claims. Leave empty until roles are assigned
# through an Admin SDK process, then use for example: broker,admin
PANORAMA_REQUIRED_ROLES=

# Persistent generated-image storage.
CLOUDINARY_CLOUD_NAME=dpnsayn8m
CLOUDINARY_UPLOAD_PRESET=libot_uploads

# Browser-direct panorama sources must be delivered under this exact public-ID
# path. Keep this identical to NEXT_PUBLIC_CLOUDINARY_SOURCE_FOLDER.
CLOUDINARY_SOURCE_FOLDER=libot/panorama-sources

# Web Push delivery (private key is backend-only).
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
NOTIFICATION_QUEUE_COLLECTION=notificationQueue
NOTIFICATION_USER_LIMIT=30
NOTIFICATION_IP_LIMIT=60
NOTIFICATION_WINDOW_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_LEASE_SECONDS=60
