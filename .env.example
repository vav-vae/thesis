# Local panorama API. Leave unset in production to use the same-origin
# /api/backend route configured by the application.
NEXT_PUBLIC_PANORAMA_API_URL=http://127.0.0.1:8000

# These values are intentionally browser-visible Cloudinary configuration, not
# secrets. The preset must be an unsigned, tightly restricted image preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dpnsayn8m
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=libot_uploads

# Keep this identical to backend CLOUDINARY_SOURCE_FOLDER. The browser and API
# both reject source URLs that do not use this exact public-ID path.
NEXT_PUBLIC_CLOUDINARY_SOURCE_FOLDER=libot/panorama-sources
# Public Web Push application key only. Never place VAPID_PRIVATE_KEY here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
